  }
  class ComputerPlayer {
    +ComputerPlayer(name: String)
  }
  class Move {
    +Move(moveType: MoveType)
    +Move(moveType: MoveType, selectedGems: Map<Gem,Integer>)
    +Move(moveType: MoveType, cardId: Integer, isReservedCard: boolean)
    +Move(moveType: MoveType, selectedGems: Map<Gem,Integer>, cardId: Integer, isReservedCard: boolean, deckTier: Integer)
    +{static} reserveFromDeck(tier: int): Move
    +getMoveType(): MoveType
    +getSelectedGems(): Map<Gem,Integer>
    +getCardId(): Integer
    +isReservedCard(): boolean
    +getDeckTier(): Integer
    +hasCardSelection(): boolean
    +hasDeckSelection(): boolean
    +hasGemSelection(): boolean
  }
  class Board {
    +Board(maxPlayers: int, config: IConfigProvider)
    +getGemBank(): Map<Gem,Integer>
    +getGemCount(gem: Gem): int
    +getAvailableCards(): Map<Integer,List<Card>>
    +getAvailableCards(tier: int): List<Card>
    +getDeckSize(tier: int): int
    +getAvailableNobles(): List<Noble>
    +removeGems(gems: Map<Gem,Integer>): void
    +addGems(gems: Map<Gem,Integer>): void
    +drawCard(tier: int): Card
    +drawBlindCard(tier: int): Card
    +removeAvailableCard(tier: int, card: Card): boolean
    +copyDecks(): Map<Integer,List<Card>>
    +restoreDecks(decks: Map<Integer,List<Card>>): void
    +removeAvailableNoble(noble: Noble): boolean
  }
  class Game {
    +Game(players: List<Player>, winningPoints: int, maxTokens: int, config: IConfigProvider)
    +saveUndoState(): void
    +undo(): boolean
    +getPlayers(): List<Player>
    +getCurrentPlayer(): Player
    +getBoard(): Board
    +getCurrentState(): GameState
    +getWinningPoints(): int
    +getMaxTokens(): int
    +addRecentMove(entry: String): void
    +getRecentMoves(): List<String>
    +getWinner(): Player
    +isFinalRound(): boolean
    +isGameFinished(): boolean
    +advanceToNextPlayer(): void
    +hasPlayerReachedWinningScore(): boolean
  }
  class MenuOption {
    +MenuOption(number: int, action: MenuAction, available: boolean, label: String, detail: String, reason: String)
    +getNumber(): int
    +getAction(): MenuAction
    +isAvailable(): boolean
    +getLabel(): String
    +getDetail(): String
    +getReason(): String
  }
  Player <|-- ComputerPlayer
  Game "1" *-- "1" Board
  Game "1" *-- "1..*" Player
  Game --> GameState : currentState
  Player "1" *-- "0..*" Card : purchasedCards / reservedCards
  Player "1" *-- "0..*" Noble : nobles
  Board "1" *-- "0..*" Card : availableCards
  Board "1" *-- "0..*" Noble : availableNobles
  Move --> MoveType
  MenuOption --> MenuAction
  Card --> Gem : bonusGem
}

